{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blitzdonner/split-flap",
	"title": "Split-Flap",
	"category": "media",
	"icon": "schedule",
	"description": "Animierte Fallblattanzeige (Split-Flap-Display) – ein kurzer Text rattert beim Erscheinen vom Startzustand zum Zieltext durch.",
	"keywords": [ "split-flap", "fallblatt", "bahnhof", "anzeige", "flip" ],
	"textdomain": "split-flap",
	"supports": {
		"html": false,
		"align": [ "left", "center", "right", "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": false
		}
	},
	"attributes": {
		"text": {
			"type": "string",
			"default": ""
		},
		"felder": {
			"type": "number",
			"default": 0
		},
		"tempo": {
			"type": "string",
			"default": "normal"
		},
		"start": {
			"type": "string",
			"default": "zufall"
		},
		"zeichen": {
			"type": "string",
			"default": "alnum"
		},
		"textfarbe": {
			"type": "string",
			"default": "#F4F4F4"
		},
		"klappenfarbe": {
			"type": "string",
			"default": "#1A1A1A"
		},
		"schrift": {
			"type": "string",
			"default": "mono"
		},
		"grossschrift": {
			"type": "boolean",
			"default": true
		}
	},
	"editorScript": "file:./editor.js",
	"style": "split-flap",
	"viewScript": "split-flap"
}
